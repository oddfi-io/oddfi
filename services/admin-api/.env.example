# OddFi 运营后台 · admin-backend 本地环境变量模板
#
# 用法：
#   cp .env.example .env.local        # 初始化（.env.local 已 gitignore，安全放密钥）
#   # 填好 .env.local 后，由启动方 source 进去再起服务：
#   set -a; source .env.local; set +a; go run ./cmd/server
#
# 原理：config.go 的 applyEnvOverride 用这些 env 覆盖 config.yaml 的同名字段
#       （后端不自动读 .env，必须先 source 到环境）。
# config.yaml 已有可用的本地默认值；下面【可选】项保持注释即沿用 config.yaml。

# ════════════════════════════════════════════════════════════════
# 【必填】Lark App Secret
#   config.yaml 里是占位 "INJECT_VIA_ENV"，不填登录会报
#   LARK_EXCHANGE_FAILED / invalid_client（你刚踩到的就是这个）。
#   来源：Lark 开放平台 → 应用 <LARK_APP_ID> → 凭证与基础信息 → App Secret
# ════════════════════════════════════════════════════════════════
ADMIN_LARK_APP_SECRET=

# ════════════════════════════════════════════════════════════════
# 【可选 · 仅当想让「预售数据页」在本地出真数据时才填】
#   预售数据是 admin-backend 转发到上游 web-api(admin-api.oddfi.io) 取的：
#     1) 下面两个密钥必须与线上 web-api 一致（否则 HMAC/JWT 验签失败）
#     2) 且本机 IP 要在 web-api 的 Nginx allow 白名单内（网络层，env 改不了）
#   来源：运维 / web-api 的 systemd EnvironmentFile。
#   不填的话：登录、管理员管理、所有页面布局都能验收；只有预售数据页会报 upstream 错。
# ════════════════════════════════════════════════════════════════
# WEBAPI_SERVICE_TOKEN=        # admin-backend → web-api 的 HMAC 签名 secret（须与 web-api 一致）
# ADMIN_JWT_SECRET=            # 与 web-api 共享的 HS256 secret（须与 web-api 一致；本地登录本身用 config.yaml 的值即可）
# WEBAPI_INTERNAL_URL=         # web-api internal endpoint 地址（默认用 config.yaml，如需改指向再填）

# ════════════════════════════════════════════════════════════════
# 【可选 · 覆盖 config.yaml 的本地基础设施，一般不用动】
#   config.yaml 已能连上本地 MySQL/Redis（后端已成功启动验证过）。
#   仅当你要换数据库/Redis 连接时才取消注释填写。
# ════════════════════════════════════════════════════════════════
# ADMIN_DB_DSN=                # MySQL DSN
# ADMIN_REDIS_ADDR=            # 如 127.0.0.1:6379
# ADMIN_REDIS_PASSWORD=
# ADMIN_LARK_APP_ID=           # config.yaml 已有正确 app_id，一般不用
# ADMIN_FRONTEND_URL=          # OAuth 成功后回跳地址，默认 http://localhost:5173/
