# /etc/oddfi-admin/env.production
#
# 生产环境敏感凭据。systemd unit 通过 EnvironmentFile= 注入。
# 权限：chmod 600 / chown root:root（仅 root 可读，systemd 进程继承环境变量给 oddfi 用户）
#
# 与 internal/config/config.go applyEnvOverride 一一对应。
# 不在此处的字段（lark.redirect_uri / lark.scope / cors.allowed_origins 等）
# 直接写在 /etc/oddfi-admin/config.yaml，不属于敏感字段。
#
# !!! 部署前务必：
#   1. 在 EC2 上手填实际值（不要在本地展开 secret 再 scp）
#   2. 检查 mode 0600：ls -la /etc/oddfi-admin/env.production
#   3. cat 验证一次后清屏；history -d 删本条
#

# MySQL DSN — admin 服务用独立 DB（与 C 端 oddfi DB 隔离）
# 推荐 DB 名：oddfi_admin（OPS-03 bootstrap 时创建）
ADMIN_DB_DSN="admin:CHANGE_ME@tcp(127.0.0.1:3306)/oddfi_admin?charset=utf8mb4&parseTime=true&loc=Local&timeout=5s"

# Redis — 与 C 端共用实例，但 DB 编号在 config.yaml 里区分（admin = db 1）
ADMIN_REDIS_ADDR=127.0.0.1:6379
ADMIN_REDIS_PASSWORD=

# JWT 签名密钥 — 用 `make jwt-secret` 生成，>= 32 字节
# 轮换：直接重写本字段 + systemctl restart，已签发的 token 全部失效（用户重新走 Lark OAuth）
ADMIN_JWT_SECRET=CHANGE_ME_RUN_make_jwt-secret_TO_GENERATE

# Lark OAuth — App ID 非敏感（docs/lark-app-binding.md §1 是 system of record），
# 但放这里方便集中注入避免 config.yaml 漂移
ADMIN_LARK_APP_ID=<LARK_APP_ID>
ADMIN_LARK_APP_SECRET=CHANGE_ME_FROM_LARK_PORTAL

# 后端 OAuth 完成后 302 回跳的前端地址。SPA 从 location.hash 解析 #token=<jwt>。
# 注意：必须与 Lark redirect_uri 路径分开，否则 Nginx 会把 302 后的请求再次路由给后端，
# 触发 "code empty" 报错。OPS-04 Nginx 配置依赖本字段 + lark.redirect_uri 的路径分离。
ADMIN_FRONTEND_URL=https://admin.oddfi.io/

# ─── web-api internal endpoint（DD-003 v3.1 B6）────────────────────────────────
#
# admin-backend 通过 HTTP 调用 web-api 内部监听地址，取代原直连业务 DB 模式。
# 两个服务通常部署在同一台机器，走 loopback 通信（不出公网）。
#
# WEBAPI_INTERNAL_URL — web-api 内部监听地址
#   格式：http://<host>:<internal_port>（不加 trailing slash）
#   典型值：http://127.0.0.1:8081（web-api 内部监听端口）
#   prod 必填，dev 可留空（admin-backend 不启动 presale 功能）
WEBAPI_INTERNAL_URL=http://127.0.0.1:8081

# WEBAPI_SERVICE_TOKEN — HMAC-SHA256 签名 secret（与 web-api 共享）
#   生成：openssl rand -hex 32
#   必须与 web-api 侧 INTERNAL_SERVICE_SECRETS 的 primary secret 完全一致
#   轮换：双侧同时配新旧两个 secret（web-api 支持多 secret 重叠期），再逐步下线旧 secret
#   prod 必填；chmod 600 本文件防止 secret 泄漏
WEBAPI_SERVICE_TOKEN=CHANGE_ME_RUN_openssl_rand_-hex_32
