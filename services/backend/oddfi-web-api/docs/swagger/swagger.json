{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Oddfi 详情页、赛事、盘口、流动池、Banner 和 token price 相关接口文档。",
        "title": "Oddfi Market Web API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/detail/fixture/{fixture_id}": {
            "get": {
                "description": "type=preview 返回预览数据，type=statis 返回统计数据，type=live 只查进行中赛事。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "detail"
                ],
                "summary": "获取指定 fixture 详情",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Fixture ID",
                        "name": "fixture_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "statis / preview / live",
                        "name": "type",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 zh",
                        "name": "locale",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerFixturesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/detail/fixture_between/{start_date}/{end_date}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "detail"
                ],
                "summary": "按日期区间获取 fixture",
                "parameters": [
                    {
                        "type": "string",
                        "description": "开始日期，格式 YYYY-MM-DD",
                        "name": "start_date",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "结束日期，格式 YYYY-MM-DD",
                        "name": "end_date",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "live 表示只返回进行中赛事",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 zh",
                        "name": "locale",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerFixturesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/detail/fixture_date/{date}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "detail"
                ],
                "summary": "按日期获取 fixture",
                "parameters": [
                    {
                        "type": "string",
                        "description": "日期，格式 YYYY-MM-DD",
                        "name": "date",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "live 表示只返回进行中赛事",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 zh",
                        "name": "locale",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerFixturesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/detail/sports_all": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "detail"
                ],
                "summary": "按联赛获取赛事",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "联赛 ID，默认 2；0 表示其他小国比赛",
                        "name": "league",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "页码，默认 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "live 表示只返回进行中赛事",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "国家/地区筛选",
                        "name": "country_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 zh",
                        "name": "locale",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerFixturesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/detail/stages_all/{stage_id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "detail"
                ],
                "summary": "按阶段获取赛事",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "阶段 ID",
                        "name": "stage_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "live 表示只返回进行中赛事",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 zh",
                        "name": "locale",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerFixturesResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/detail/ws": {
            "get": {
                "description": "升级为 WebSocket 后推送详情页 K 线数据。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "detail"
                ],
                "summary": "K 线 WebSocket",
                "responses": {
                    "101": {
                        "description": "Switching Protocols",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/liquidity/details/market_all": {
            "get": {
                "description": "按下注热度和开赛时间排序未开赛赛事，Redis 热度异常时降级为 0，不影响列表可用性。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "liquidity"
                ],
                "summary": "获取流动池精选赛事",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "页码，默认 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "每页条数，默认 25，最大 100",
                        "name": "page_size",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 zh",
                        "name": "locale",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerLiquidityResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/liquidity/details/market_search": {
            "get": {
                "description": "按当前 locale 下的队伍名称搜索未开赛赛事。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "liquidity"
                ],
                "summary": "搜索流动池赛事",
                "parameters": [
                    {
                        "type": "string",
                        "description": "队伍名称关键词",
                        "name": "name",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "页码，默认 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "每页条数，默认 25，最大 100",
                        "name": "page_size",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 zh",
                        "name": "locale",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerLiquidityResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/market/banners": {
            "get": {
                "description": "返回首页/Market 顶部 Banner 配置和可下注选项。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "banner"
                ],
                "summary": "获取 Market Banner 列表",
                "parameters": [
                    {
                        "type": "string",
                        "description": "语言，默认 en；支持 en/zh/pt/ja/es/tr/de/fr/hi",
                        "name": "lang",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerMarketBannerResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/market/banners/{banner_id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "banner"
                ],
                "summary": "获取指定 Banner 详情",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Banner 模板 ID",
                        "name": "banner_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "语言，默认 en",
                        "name": "lang",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerMarketBannerDetailResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/token/batch_price": {
            "post": {
                "description": "单次最多 100 个 token；服务端会按链分组并发查询并写入 Redis 缓存。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "token"
                ],
                "summary": "批量查询 token 价格",
                "parameters": [
                    {
                        "description": "批量 token 查询请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerBatchTokenPriceRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerBatchTokenPriceResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/token/price": {
            "get": {
                "description": "通过 GeckoTerminal 查询 token price，价格以字符串返回，避免链上价格精度损失。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "token"
                ],
                "summary": "查询单个 token 价格",
                "parameters": [
                    {
                        "type": "string",
                        "description": "链 ID/网络名，例如 bsc、polygon_pos、base、eth、arbitrum",
                        "name": "chain_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "token 合约地址",
                        "name": "address",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerTokenPriceResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerErrorResponse"
                        }
                    }
                }
            }
        },
        "/health_check": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.swaggerMarketResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
