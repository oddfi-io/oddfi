                "data": {
                    "description": "token price 是链上行情数据，价格保持字符串，避免前端用浮点数造成精度和展示误差。",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handler.TokenPriceData"
                    }
                },
                "msg": {
                    "type": "string"
                }
            }
