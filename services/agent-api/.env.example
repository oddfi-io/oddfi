# oddfi-agent-backend 环境变量模板
# 部署时复制为 .env（本地）/ .env.prod / .env.dev（服务器），并填入真实值。
# 这些文件 .gitignore 排除，永远不入库。

# ── 上游 / LLM 凭据 ──────────────────────────────────
TWEET_CATCHER_TOKEN=your_tweet_catcher_token_here
# AI_ 系列 provider-agnostic，OpenAI 兼容协议；切 provider 改这三行即可
#   xAI/Grok      : AI_BASE_URL=https://api.x.ai/v1         AI_MODEL=grok-4-fast-non-reasoning
#   Moonshot/Kimi : AI_BASE_URL=https://api.moonshot.cn/v1  AI_MODEL=moonshot-v1-8k
#   DeepSeek      : AI_BASE_URL=https://api.deepseek.com/v1 AI_MODEL=deepseek-chat
#   OpenAI        : AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.moonshot.cn/v1
AI_MODEL=moonshot-v1-8k

# ── 服务端口 / 数据库 ───────────────────────────────
# 本地开发用 :8080；容器内固定 :8090（与 nginx 反代上游对齐）
# 强约束：生产部署必须 listen 127.0.0.1:8090（host network 模式 + 仅 nginx 反代）
#         避免 AWS Security Group 误开 8090 时绕过 nginx
SERVER_ADDR=127.0.0.1:8090
# 本地：./data/cards.db；容器内：/data/cards.db（由 -v 挂载到 /var/lib/oddfi-agent-backend/{env}/）
DB_PATH=./data/cards.db

# ── CORS（精确匹配，ENH-002 用户决策不支持通配/regex） ────────
# 本地：localhost:3000（后端 demo 前端）+ localhost:4000-4002（前端三个 dev 端口）
# 正式 subdomain：oddfi.io / www / app / testnet / pre / dev（各部署环境一一显式枚举）
# 新增 subdomain：改本 env + scp + docker restart 即可生效，无须 rebuild 镜像
# 多 origin 用逗号分隔；勿加 trailing 空格
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4001,http://localhost:4002

# ── 业务调优 ─────────────────────────────────────
# /api/dev/* 必须在 prod 与 staging 都关；本地开发可设 true 用 inject 注入 mock
DEV_API_ENABLED=false
# SSE 全局连接上限：prod 200 / dev 50（dev 内存紧）
MAX_SSE_CONNS=100
# enrich worker pool 大小 / 队列容量
ENRICH_WORKERS=4
ENRICH_QUEUE_CAP=100

# ── ENH-002 限流（不配则走代码默认值） ───────────────────
# 单 IP 同时 SSE 连接上限（建议 3，浏览器开多 tab 留余量）
SSE_PER_IP_LIMIT=3
# 全局 SSE 软上限百分比 [1,100]：到达 MAX_SSE_CONNS × pct/100 时新连接 503
SSE_SOFT_LIMIT_PCT=80
# SSE per-IP map 硬上限（防 map 增长攻击）
SSE_MAX_TRACKED_IPS=50000
# /api/push per-IP 每分钟请求数 + 突发
REST_RATE_PER_IP=60
REST_RATE_BURST=3
# /api/chat per-IP 每分钟请求数 + 突发（防 LLM token 被打爆）
CHAT_RATE_PER_IP=10
CHAT_RATE_BURST=2
# REST IPLimiter map 硬上限
RATELIMIT_MAX_TRACKED_IPS=50000

# ── Go runtime（dev 256m 内存机器必填） ─────────────
# GOMEMLIMIT 是 Go 1.19+ soft memory limit，让 GC 提前介入比 OOMKill 优雅
# dev (256m) 建议 200MiB；prod (512m) 建议 400MiB；本地不限
# GOMEMLIMIT=200MiB
