# oddfi-agent-backend nginx site config (FULL, with TLS + SSE)
#
# 用法：
#   prod : 把所有 __DOMAIN__ 替换为 news-api.oddfi.io
#   dev  : 把所有 __DOMAIN__ 替换为 dev-news-api.oddfi.io
#
# 部署位置：/etc/nginx/sites-available/__DOMAIN__
# 启用    ：sudo ln -s /etc/nginx/sites-available/__DOMAIN__ /etc/nginx/sites-enabled/
# 重载    ：sudo nginx -t && sudo systemctl reload nginx
#
# ⚠ 重要约束：本 site 用 `certbot certonly --webroot` 配合签证书；
#    禁止用 `certbot --nginx` —— 该模式会改写本文件丢失 SSE 优化与 /api/dev/ 防线。

server {
    # nginx 1.24（Ubuntu 24.04 默认）尚不支持独立的 `http2 on;` 指令；
    # 仍用旧写法把 http2 接在 listen 后。1.25.1+ 可改成 `http2 on;` 独立行。
    listen 443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    # Mozilla Intermediate 2025 ── 禁掉 TLS_RSA / 3DES，SSL Labs A 级
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # ── 安全响应头（全 location 共享） ───────────
    add_header Strict-Transport-Security "max-age=15768000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "no-referrer" always;

    # ⚠ nginx 继承坑：location 内出现任何 proxy_set_header 会覆盖 server 块所有声明。
    # 所以每个 location 内都显式重声明所需 proxy_set_header（不要把 4 条放 server 块）。

    # ENH-002 应急 IP 黑名单 ── $blocklist 在 /etc/nginx/conf.d/blocklist.conf 内定义（geo 块）。
    # deploy.sh 保证该文件存在（即便为空 geo），server 块内仅判定。命中返回 444（关连接不响应）。
    if ($blocklist) { return 444; }

    # 0) /api/dev/* 深度防御 ── 即使 .env 漏配 DEV_API_ENABLED=true 也不暴露
    location ^~ /api/dev/ {
        return 404;
    }

    # 1) SSE 长连接 ── 关 buffering + 关 gzip + 3600s 读超时
    #    后端 30s 心跳一次 ping，nginx 1h 读超时足够吸收。
    #    proxy_buffering off 关上游缓冲；gzip off 关下游压缩缓冲；X-Accel-Buffering 显式
    #    告知任何上游代理/CDN 不要再 buffer（防 Cloudflare 套上后断流）。
    location = /api/push/stream {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # ⚠ ENH-002 安全要求：用 $remote_addr 替换，不要用 $proxy_add_x_forwarded_for（追加链）。
        # 后者会把客户端伪造的 X-Forwarded-For 头保留在链头，让 Go realIP() 信错值。
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        '';

        proxy_buffering           off;
        proxy_cache               off;
        proxy_request_buffering   off;
        proxy_max_temp_file_size  0;
        gzip                      off;
        chunked_transfer_encoding off;
        tcp_nodelay               on;

        add_header X-Accel-Buffering no always;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 2) 普通 REST API
    #    client_max_body_size 与后端 BodySizeLimit 对齐（1 MiB）
    location /api/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # ⚠ ENH-002 安全要求：用 $remote_addr 替换，不要用 $proxy_add_x_forwarded_for（追加链）。
        # 后者会把客户端伪造的 X-Forwarded-For 头保留在链头，让 Go realIP() 信错值。
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        client_max_body_size 1m;
    }

    # 3) 健康检查 ── 不写 access_log 减磁盘压力
    location = /healthz {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host             $host;
        # 与其他 location 保持一致 —— 未来若加 healthz 限流不需要再补 header（security review L2）
        proxy_set_header X-Real-IP        $remote_addr;
        proxy_set_header X-Forwarded-For  $remote_addr;
        access_log off;
    }

    # 4) 根路径 404
    location / {
        return 404;
    }
}

# HTTP → HTTPS 重定向
# 同时保留 /.well-known/acme-challenge/ 给 certbot 续签用（certonly --webroot 模式）
server {
    listen 80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
