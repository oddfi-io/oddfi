# magic-signer environment configuration template.
# Copy to .env for local development; never commit a real .env.
# In production, inject via K8s Secret + ConfigMap (no .env file on disk).

# ─── REQUIRED ────────────────────────────────────────────────────────────

# Deployment environment. Must be "prod" or "test" (no other values).
# This MUST match the Magic app you're using (pk_live_* vs pk_test_*).
APP_ENV=test

# HTTP server address. Default ":8443".
# Public binds (0.0.0.0:*) are blocked unless ALLOW_PUBLIC_LISTEN=1.
LISTEN_ADDR=:8443

# Magic API key. Strict prefix check:
#   APP_ENV=prod → must start with pk_live_
#   APP_ENV=test → must start with pk_test_
MAGIC_API_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Magic OIDC provider UUID (from Magic dashboard).
MAGIC_OIDC_PROVIDER_ID=852163cb-5a5c-4ca9-923d-49eec471cc70

# Magic-Referrer header. Should match your app's domain.
MAGIC_REFERRER=https://www.oddfi.io

# OIDC signing RSA private key (PEM PKCS8, multiline).
# At least 2048 bits. Sign JWTs with this; Magic verifies via your JWKS.
OIDC_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----
... your key here ...
-----END PRIVATE KEY-----"

# JWT header.kid — must match a kid in your published JWKS.
OIDC_KID=uniq-123

# JWT iss — must match the issuer registered in Magic dashboard.
OIDC_ISSUER=https://www.oddfi.io/

# JWT aud — typically your app identifier.
OIDC_AUDIENCE=oddfi-app

# ─── CALLER AUTHENTICATION (at least one required) ───────────────────────
# Each caller has its own token. Value here is sha256 hex of the raw token.
# Generate: echo -n "<raw-token>" | sha256sum | cut -d' ' -f1
CALLER_TOKEN_WEB_API=abc123...64charsha256hex...

# Optional per-caller op restriction (csv). Omit = all ops.
# CALLER_OPS_WEB_API=address,sign
# CALLER_TOKEN_ADMIN_SVC=def456...
# CALLER_OPS_ADMIN_SVC=address

# ─── OPTIONAL (defaults shown) ───────────────────────────────────────────

# MAGIC_CHAIN=ETH
# MAGIC_ENDPOINT=https://tee.express.magiclabs.com
# MAGIC_TIMEOUT=5s
# MAGIC_MAX_RETRIES=3
# MAGIC_RETRY_BASE_DELAY=200ms
# JWT_LIFETIME=30m
# JWT_REFRESH_SAFETY=1m
# ADDR_CACHE_TTL=24h
# ADDR_CACHE_MAX=100000
# HEALTH_CHECK_INTERVAL=30s
# LOG_LEVEL=info
