{
  "name": "web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:4000": "next dev --port 4000",
    "dev:test": "lsof -ti:4001 | xargs kill -9 2>/dev/null; dotenv -e .env.dev.local -- next dev --port 4001",
    "dev:testnet": "lsof -ti:4002 | xargs kill -9 2>/dev/null; dotenv -e .env.testnet.local -- next dev --port 4002",
    "dev:earlybird": "lsof -ti:4003 | xargs kill -9 2>/dev/null; dotenv -e .env.earlybird.local -- next dev --port 4003",
    "dev:subscription": "lsof -ti:4004 | xargs kill -9 2>/dev/null; dotenv -e .env.subscription.local -- next dev --port 4004",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:watch": "vitest",
    "clean": "rm -rf .next",
    "prepare": "husky",
    "wt": "bash bin/wt-add.sh",
    "sync:branches": "bash bin/sync-branches.sh",
    "update-designs-index": "bash bin/update-designs-index.sh",
    "gen-assets": "node scripts/gen-assets.mjs",
    "gen:favicons": "node scripts/generate-favicons.mjs",
    "sync-tokens": "tsx scripts/sync-tokens.ts",
    "migrate:i18n-symbol": "tsx scripts/migrate-i18n-symbol.ts",
    "check:i18n-symbol": "tsx scripts/check-i18n-symbol.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@relayprotocol/relay-sdk": "^5.2.1",
    "@sentry/nextjs": "^10.44.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.24",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.16",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "framer-motion": "^12.34.3",
    "html-to-image": "^1.11.13",
    "ky": "^1.14.3",
    "lightweight-charts": "^5.1.0",
    "liquid-glass-react": "^1.1.1",
    "mipd": "^0.0.7",
    "msw": "^2.12.10",
    "next": "15.3.9",
    "next-intl": "^4.8.3",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-rnd": "^10.5.3",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.46.3",
    "wagmi": "^2.19.5",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@locator/runtime": "^0.5.1",
    "@locator/webpack-loader": "^0.5.1",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "15.3.9",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.0",
    "playwright": "^1.58.2",
    "png-to-ico": "^3.0.1",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
