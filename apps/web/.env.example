# ============================================================
# Oddfi Frontend — 环境变量模板
# 复制此文件为 .env.local 并填入真实值
# cp .env.example .env.local
#
# 双环境启动方式：
#   pnpm dev       → http://localhost:3000，读 .env.local（正式环境：api.oddfi.io / market-api.oddfi.io）
#   pnpm dev:test  → http://localhost:5000，读 .env.dev.local（dev 测试服：dev-api.oddfi.io 账户 + dev-market-api.oddfi.io:8080 市场）
#                    端口隔离：localStorage 按 origin 分离，token / session / 钱包状态在两环境互不污染
#                    若缺失 .env.dev.local 文件会静默回退到 .env.local，接口会误指向正式环境
# ============================================================

# ----- API -----
# API 基础路由（当前走 MSW / Next.js Route Handler）
NEXT_PUBLIC_API_BASE_URL=/api

# ----- MSW Mock -----
# true = Mock 数据（Demo 阶段）；false 或删除 = 真实后端
NEXT_PUBLIC_ENABLE_MSW=true

# ----- DevTools -----
# true = 生产环境也显示设置按钮；删除或 false = 仅 dev/preview 显示
NEXT_PUBLIC_SHOW_DEV_TOOLS=true

# ----- Auth -----
# 4 态状态机（DD-072）回滚开关：true=新逻辑（默认），false=旧 disconnect 行为
NEXT_PUBLIC_AUTH_4STATE=true

# ----- Web3 -----
# WalletConnect Project ID — 从 https://cloud.walletconnect.com 获取
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Chain: 56 = BSC Mainnet, 97 = BSC Testnet
NEXT_PUBLIC_CHAIN_ID=56

# ----- Network Mode (DD-079) -----
# testnet 模式 env 不放本文件，应放独立的 .env.testnet.local（git 忽略）
# 由 pnpm dev:testnet 通过 dotenv-cli 加载，避免污染 mainnet 默认行为
# .env.testnet.local 模板：
#   NEXT_PUBLIC_NETWORK_MODE=testnet
#   NEXT_PUBLIC_BSC_TESTNET_RPC_URL=<可选，公共 RPC 限流时自备>
# Vercel Preview 部署 testnet 模式：在 Project Settings → Env 单独建 Preview scope

# ----- 多链 RPC (Phase 2) -----
# undefined 时 fallback 到链默认公共 RPC；BSC / ETH 限流严重，生产环境强烈建议配置
NEXT_PUBLIC_BSC_RPC_URL=
# BSC Testnet RPC 不放此处，统一进 .env.testnet.local（见上方 Network Mode 章节）
# ETH Mainnet — 推荐 Alchemy / Infura（公共 RPC 限流严重，小额用户建议提示改用 Arbitrum/Base）
NEXT_PUBLIC_ETH_RPC_URL=
# Arbitrum One
NEXT_PUBLIC_ARB_RPC_URL=
# Base
NEXT_PUBLIC_BASE_RPC_URL=
# Polygon
NEXT_PUBLIC_POLYGON_RPC_URL=

# ----- 访问保护 -----
# 邀请码（本地开发 + Vercel 部署均需设置）
INVITE_CODE=

# ----- 主站早鸟模式 (DD-103) -----
# 仅主站 oddfi.io Production 启用：去除邀请码闸门，所有跨路由跳转 / 钱包入口弹「早鸟登记」Modal
# 1 = 启用（仅 Vercel main Production 设置），其他值 / 缺失 = 关闭（testnet/dev/pre 行为不变）
NEXT_PUBLIC_EARLY_BIRD_MODE=
#
# 本地模拟早鸟模式（端口 4003，避免污染默认 .env.local）：
#   1. 在仓库根创建 .env.earlybird.local，内容仅一行：NEXT_PUBLIC_EARLY_BIRD_MODE=1
#   2. pnpm dev:earlybird  → http://localhost:4003
# 缺 .env.earlybird.local 时 dotenv 静默回落到默认 env，模式不会启用。

# ----- 主站认购模式 (DD-113) -----
# 与早鸟模式互斥（=1 时强制覆盖早鸟）：主站全功能可见，但链上 / 资金 / 邀请操作冻结，
# 仅 /invest 入口可操作。1 = 启用，其他值 / 缺失 = 关闭。
NEXT_PUBLIC_SUBSCRIPTION_MODE=
#
# 本地模拟认购模式（端口 4004）：
#   1. 在仓库根创建 .env.subscription.local，内容仅一行：NEXT_PUBLIC_SUBSCRIPTION_MODE=1
#   2. pnpm dev:subscription  → http://localhost:4004
# 缺 .env.subscription.local 时 dotenv 静默回落到默认 env，模式不会启用。

# ----- 认购可见性 kill-switch (DD-119) -----
# Token(/odd-presale) 与 Presale(/invest) 入口 + 路由的总开关。
# testnet 默认隐藏；mainnet 默认显示，置 1 可在 mainnet 下线认购（入口隐藏 + 路由 307 回首页）。
# 本地默认 mainnet（未设 NEXT_PUBLIC_NETWORK_MODE）→ 想本地隐藏 Token/presale 必须置 1。只认 "1"。
NEXT_PUBLIC_PRESALE_DISABLED=

# ----- 功能上线收敛开关 (DD-144) -----
# lend / swap 主网上线时整体下架（导航入口隐藏 + 路由 307 回首页），待产品决定回归。
# 语义：默认隐藏（所有环境），要在某环境恢复显示，把对应变量置 1。只认 "1"，其他值 / 缺失 = 隐藏。
NEXT_PUBLIC_LEND_ENABLED=
NEXT_PUBLIC_SWAP_ENABLED=

# ----- Sentry 错误监控 -----
# 配置指南: docs/sentry-setup.md
# DSN — 从 Sentry Project Settings → Client Keys 获取
NEXT_PUBLIC_SENTRY_DSN=

# Organization Token（Scope: org:ci）— 构建时上传 Source Map，本地和 Vercel 用同一个值
SENTRY_AUTH_TOKEN=

# Personal Token（Scope: project:read, event:read, organization:read）— /sentry Skill 查询 Issue
SENTRY_LOCAL_AUTH_TOKEN=

# Organization slug（Sentry URL 中的组织标识）
SENTRY_ORG=

# Project slug（Sentry URL 中的项目标识，如 oddfi-frontend）
SENTRY_PROJECT=

# ----- 后端 API -----
# 服务端专用，Next.js API Route 代理使用，不暴露给浏览器
BACKEND_URL=http://api.oddfi.io

# ----- Market Data API (赛事数据后端) -----
# 服务端专用，供 /api/v1 代理路由转发市场数据请求
MARKET_API_URL=https://market-api.oddfi.io

# ----- WebSocket K-line (BNB/USDT 实时 K 线图) -----
# 客户端直连，浏览器 WebSocket 连接用
NEXT_PUBLIC_WS_KLINE_URL=wss://market-api.oddfi.io/ws

# ----- WebSocket tx_status (DD-101) -----
# 链上交易终态推送（success/failed/timeout），独立 wss 子域
# 通用命名：NEXT_PUBLIC_WS_<SERVICE>_URL（参考 docs/websocket-integration.md）
# 缺失/空 → 前端走 wagmi useWaitForTransactionReceipt 降级，不静默
# dev/local: wss://ws-dev.oddfi.io/ws（后端 nginx + TLS 落地后；临时本地可用 ws://<SERVER_IP>:19090/ws）
# prod:      wss://ws.oddfi.io/ws（2026-06-15 已实配：nginx vhost + Let's Encrypt TLS + 反代 ws-service :19090，healthz=200 实测）
NEXT_PUBLIC_WS_TX_URL=

# ----- WebSocket odds_updated (DD-118) -----
# 链上赔率推送（oddfi-data-ws），subscribe-style，无 auth
# 协议：{ action: "subscribe", marketIds: [...] } → 服务端推 odds_updated 事件
# 缺失/空 → 前端降级到 REST base_odds，无实时刷新（status='disabled'）
# 中间代理空闲断连阈值需向运维确认 > 25s（客户端 25s 主动 ping）
# testnet: wss://dev-market-api.oddfi.io/odds-ws（nginx /odds-ws → data-ws :8091/ws；2026-06-14 服务器实配核实）
# prod:    wss://market-api.oddfi.io/odds-ws（2026-06-15 已实配：nginx /odds-ws → data-ws :8091/ws，行为同已工作的 KLINE /ws；注意同域 /ws 是 KLINE，勿混）
NEXT_PUBLIC_WS_ODDS_URL=

# ----- Lark MCP -----
# Lark/飞书 Open Platform App 凭证，供 MCP Server 使用
# 从飞书开放平台 https://open.feishu.cn 获取
LARK_APP_ID=
LARK_APP_SECRET=

# ----- AI Agent (DD-106) -----
# AI 聊天 Route Handler (/api/ai/chat) 使用，仅服务端可见，不暴露给浏览器
# 支持 deepseek / kimi / xai 三 provider，缺省走 deepseek
AI_PROVIDER=deepseek
# DeepSeek API Key — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Moonshot (Kimi) API Key — https://platform.moonshot.cn
KIMI_API_KEY=
# xAI API Key (Grok 模型) — https://console.x.ai  · key 以 "xai-" 开头
XAI_API_KEY=

# ----- News Push API (DD-110) -----
# oddfi-agent-backend 推送服务（Twitter 实时推送卡 + SSE 长连）
# 浏览器直连（不走 Next.js 代理）；CORS 由后端 CORS_ALLOWED_ORIGINS 放通
# dev:    https://dev-news-api.oddfi.io
# prod:   https://news-api.oddfi.io
# 缺失/空 → 浮窗「新闻」tab 渲染禁用占位「新闻服务未配置」，不静默回落
NEXT_PUBLIC_NEWS_API_BASE_URL=
