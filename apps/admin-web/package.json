    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "geist": "^1.7.0",
    "ky": "^2.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
